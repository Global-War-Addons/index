{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gw-catalog/history.schema.json",
  "title": "history/<id>.<hash8>.json: all published versions of an addon (immutable, named by the hash of its content)",
  "type": "array",
  "items": {
    "$ref": "#/$defs/history_entry"
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "api": {
      "type": "string",
      "pattern": "^([0-9]+\\.[0-9]+\\.[0-9]+)?$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "size",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9_]+-[0-9]+\\.[0-9]+\\.[0-9]+(\\.part[1-9][0-9]*)?\\.zip$"
        },
        "kind": {
          "enum": [
            "content"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "version_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "tag",
        "date",
        "pre",
        "api",
        "plugin_api",
        "depends",
        "conflicts",
        "load_after",
        "patches",
        "caps",
        "save_compat",
        "breaks_saves",
        "size",
        "assets",
        "game",
        "merge_files"
      ],
      "properties": {
        "v": {
          "$ref": "#/$defs/version"
        },
        "tag": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "pre": {
          "type": "boolean"
        },
        "api": {
          "$ref": "#/$defs/api"
        },
        "plugin_api": {
          "$ref": "#/$defs/api"
        },
        "depends": {
          "type": "string"
        },
        "conflicts": {
          "type": "string"
        },
        "load_after": {
          "type": "string"
        },
        "patches": {
          "type": "string"
        },
        "caps": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "ffi",
              "fs_write",
              "os_exec"
            ]
          }
        },
        "save_compat": {
          "type": "integer",
          "minimum": 0
        },
        "breaks_saves": {
          "type": "boolean"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/asset"
          }
        },
        "game": {
          "type": "string"
        },
        "merge_files": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "history_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "tag",
        "date",
        "pre",
        "api",
        "plugin_api",
        "depends",
        "conflicts",
        "load_after",
        "patches",
        "caps",
        "save_compat",
        "breaks_saves",
        "size",
        "assets",
        "game",
        "merge_files",
        "notes",
        "yanked"
      ],
      "properties": {
        "v": {
          "$ref": "#/$defs/version"
        },
        "tag": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "pre": {
          "type": "boolean"
        },
        "api": {
          "$ref": "#/$defs/api"
        },
        "plugin_api": {
          "$ref": "#/$defs/api"
        },
        "depends": {
          "type": "string"
        },
        "conflicts": {
          "type": "string"
        },
        "load_after": {
          "type": "string"
        },
        "patches": {
          "type": "string"
        },
        "caps": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "ffi",
              "fs_write",
              "os_exec"
            ]
          }
        },
        "save_compat": {
          "type": "integer",
          "minimum": 0
        },
        "breaks_saves": {
          "type": "boolean"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/asset"
          }
        },
        "game": {
          "type": "string"
        },
        "merge_files": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": "string"
        },
        "yanked": {
          "type": "boolean"
        }
      }
    }
  }
}
