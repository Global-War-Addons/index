{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gw-catalog/stats.schema.json",
  "title": "stats.json (11-catalog-distribution.md 4.4): [downloads, stars] by id",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "stats"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "generated_at": {
      "$ref": "#/$defs/datetime"
    },
    "stats": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,64}$"
    },
    "datetime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
