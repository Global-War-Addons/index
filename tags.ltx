; The dictionary of tags (11-catalog-distribution.md 3.2): catalog.ltx "tags" may use only these keys.
; key = description (the launcher translates the key itself; the description is for authors).

[tags]
weapons       = weapons, ammo, attachments
armor         = armor, outfits, helmets
traders       = traders and trade
npc           = NPCs, squads, factions
mutants       = mutants
quests        = quests and dialogs
locations     = new or changed locations
weather       = weather, sky, lighting
graphics      = textures, models, shaders
sounds        = sounds and music
ui            = interface, HUD, PDA, menus
gameplay      = gameplay mechanics, balance
economy       = economy, prices, loot
ai            = behaviour of NPCs and mutants
translation   = translations
library       = for other addons
cheats        = debug and cheat tools
